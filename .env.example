# =============================================================================
# financebench-rag-eval — environment variables template
# =============================================================================
# Copy this file to `.env` and fill in your real keys. `.env` is gitignored
# and must NEVER be committed.
#
#   cp .env.example .env
#
# Then load in Python with:
#
#   from dotenv import load_dotenv
#   load_dotenv()
#
# =============================================================================
# Embedding & reranking APIs
# =============================================================================

# OpenAI — baseline embedder `text-embedding-3-large` (3072 dim).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voyage AI — finance-specialized embedder `voyage-finance-2`.
# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere — reranker `rerank-v3.5`.
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — Contextual Retrieval (Claude Haiku with prompt caching).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Hugging Face
# =============================================================================

# Required for: dataset downloads (FinanceBench, FinMTEB) at full speed,
# model downloads (BGE-M3, Jina, Qwen3) without rate-limit warnings,
# publishing the fine-tuned BGE-M3 to the Hub on Day 21.
# `read` scope is enough for download; `write` needed only for publishing.
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Optional / future
# =============================================================================

# Default reproducibility seed used across bootstrap, splits, fine-tuning.
# Override only if you need to compare runs under different seeds.
# SEED=42

# Override the HuggingFace cache location (default: ~/.cache/huggingface/).
# Useful if your home dir is on a small disk and models live on external SSD.
# HF_HOME=/Volumes/External/huggingface
